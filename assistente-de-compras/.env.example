# ============================================================
#  Assistente de compras - copie para .env e preencha
# ============================================================

# --- Telegram (obrigatorio para receber alertas) -------------
# Token que o @BotFather entrega ao criar o bot
TELEGRAM_TOKEN=123456789:AAAbbbCCCdddEEEfffGGGhhhIIIjjjKKKlll
# Seu chat pessoal com o bot (veja no README como descobrir)
TELEGRAM_CHAT_ID=987654321
# Opcional: outros chats que podem mandar comandos (separados por virgula)
TELEGRAM_CHATS_AUTORIZADOS=

# --- Banco de dados -----------------------------------------
# Padrao: data/wishlist.db dentro da pasta do projeto
# CAMINHO_BANCO=/caminho/absoluto/wishlist.db

# --- Comportamento do scraping ------------------------------
TIMEOUT_REQUISICAO=20        # segundos por requisicao
TENTATIVAS=3                 # retentativas com backoff exponencial
ESPERA_MIN_SEGUNDOS=3        # intervalo minimo entre produtos
ESPERA_MAX_SEGUNDOS=7        # intervalo maximo entre produtos
RESPEITAR_ROBOTS=true        # false = ignora o robots.txt do site (sua responsabilidade)
USAR_PLAYWRIGHT=false        # true = sempre renderiza a pagina com navegador

# --- Alertas -------------------------------------------------
HORAS_ENTRE_ALERTAS=24       # nao repete o mesmo alerta antes disso
NOTIFICAR_ERROS=false        # true = avisa no Telegram quando uma leitura falha

# --- Log -----------------------------------------------------
NIVEL_LOG=INFO               # DEBUG para investigar extracao de preco
